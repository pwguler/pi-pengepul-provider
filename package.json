{
  "name": "@pwguler/pi-pengepul-provider",
  "version": "0.5.2",
  "type": "module",
  "description": "pi custom provider for pengepul, a relay that pools your Claude/Codex subscriptions. Key and relay base live in auth.json; both native wires (Anthropic Messages, OpenAI Chat Completions) come from one catalog.",
  "license": "MIT",
  "author": "pwguler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwguler/pi-pengepul-provider.git"
  },
  "main": "./extensions/index.ts",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "pi-pengepul-provider",
    "pengepul",
    "provider"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5.9.3"
  }
}
